#!/bin/bash
# ADVANCED TOR BLOCKER


# Fichier temporaire
TMP_FILE="/tmp/tor_exit_addresses.txt"

# Récupère la liste officielle Tor exit nodes
curl -s https://check.torproject.org/exit-addresses > $TMP_FILE

# Sépare IPv4 et IPv6
NEW_IPV4=$(grep ExitAddress $TMP_FILE | awk '{print $2}' | grep -v ':')
NEW_IPV6=$(grep ExitAddress $TMP_FILE | awk '{print $2}' | grep ':')

# Crée les sets si nécessaire
nft list set inet filter tor_ipv4 &>/dev/null || \
nft add set inet filter tor_ipv4 { type ipv4_addr; flags interval; }
nft list set inet filter tor_ipv6 &>/dev/null || \
nft add set inet filter tor_ipv6 { type ipv6_addr; flags interval; }

# Fonction pour synchroniser un set nftables avec une nouvelle liste
sync_nft_set() {
    local SET_NAME=$1
    local NEW_LIST="$2"

    # Récupère les IP existantes dans le set
    EXISTING=$(nft list set inet filter $SET_NAME | grep -Eo '([0-9a-fA-F:.]+)' || true)

    # Ajouter les IP qui ne sont pas encore dans le set
    for ip in $NEW_LIST; do
        if ! grep -qx "$ip" <<< "$EXISTING"; then
            nft add element inet filter $SET_NAME { $ip }
        fi
    done

    # Supprimer les IP qui ne sont plus dans la nouvelle liste
    for ip in $EXISTING; do
        if ! grep -qx "$ip" <<< "$NEW_LIST"; then
            nft delete element inet filter $SET_NAME { $ip }
        fi
    done
}

# Synchronisation des sets
sync_nft_set tor_ipv4 "$NEW_IPV4"
sync_nft_set tor_ipv6 "$NEW_IPV6"

# Ajoute les règles de blocage si elles n'existent pas
nft list chain inet filter input | grep -q 'tor_ipv4' || \
nft add rule inet filter input ip saddr @tor_ipv4 drop
nft list chain inet filter input | grep -q 'tor_ipv6' || \
nft add rule inet filter input ip6 saddr @tor_ipv6 drop

echo "Tor exit nodes synchronisés et bloqués !"
